{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "..",
    "baseUrl": "..",
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../src/game/**/*.ts", "../src/arena/**/*.ts"]
}
