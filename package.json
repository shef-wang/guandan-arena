{
  "name": "guandan-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "arena:headless": "esbuild src/arena/runSpectatorConfig.ts --bundle --platform=node --format=cjs --outfile=/tmp/runSpectatorConfig.cjs && node /tmp/runSpectatorConfig.cjs",
    "arrange:verify": "esbuild src/game/autoArrange.verify.ts --bundle --platform=node --format=cjs --outfile=/tmp/autoArrangeVerify.cjs && node /tmp/autoArrangeVerify.cjs",
    "arrange:spotcheck": "esbuild src/game/autoArrange.spotcheck.ts --bundle --platform=node --format=cjs --outfile=/tmp/autoArrangeSpotCheck.cjs && node /tmp/autoArrangeSpotCheck.cjs",
    "server:build": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=server/dist/index.mjs --external:ws --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "server:start": "npm run server:build && node server/dist/index.mjs",
    "server:dev": "npm run server:build && node --watch server/dist/index.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "ws": "^8.20.0"
  }
}
